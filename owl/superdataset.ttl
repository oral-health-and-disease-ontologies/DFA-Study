###  https://w3id.org/OHD/DFA-study/superdataset/AgeGroup
superdataset:AgeGroup rdf:type owl:Class ;
                      owl:equivalentClass [ rdf:type owl:Class ;
                                            owl:unionOf ( NCIT:C54031
                                                          <https://w3id.org/OHD/DFA-study/superdataset/AgeGroup#1>
                                                          <https://w3id.org/OHD/DFA-study/superdataset/AgeGroup#2>
                                                          <https://w3id.org/OHD/DFA-study/superdataset/AgeGroup#3>
                                                          <https://w3id.org/OHD/DFA-study/superdataset/AgeGroup#4>
                                                          <https://w3id.org/OHD/DFA-study/superdataset/AgeGroup#5>
                                                          <https://w3id.org/OHD/DFA-study/superdataset/AgeGroup#6>
                                                        )
                                          ] ;
                      rdfs:label "AgeGroup" ;
                      skos:definition "An enumeration for the age group of the participant." ;
                      skos:inScheme <https://w3id.org/OHD/DFA-study/superdataset> ;
                      linkml:permissible_values NCIT:C54031 ,
                                                <https://w3id.org/OHD/DFA-study/superdataset/AgeGroup#1> ,
                                                <https://w3id.org/OHD/DFA-study/superdataset/AgeGroup#2> ,
                                                <https://w3id.org/OHD/DFA-study/superdataset/AgeGroup#3> ,
                                                <https://w3id.org/OHD/DFA-study/superdataset/AgeGroup#4> ,
                                                <https://w3id.org/OHD/DFA-study/superdataset/AgeGroup#5> ,
                                                <https://w3id.org/OHD/DFA-study/superdataset/AgeGroup#6> .


