#################################################################
#    Data properties
#################################################################

###  https://w3id.org/OHD/DFA-study/superdataset/Age
superdataset:Age rdf:type owl:DatatypeProperty ;
                 rdfs:range [ rdf:type rdfs:Datatype ;
                              owl:intersectionOf ( [ rdf:type rdfs:Datatype ;
                                                     owl:unionOf ( [ rdf:type rdfs:Datatype ;
                                                                     owl:intersectionOf ( [ rdf:type rdfs:Datatype ;
                                                                                            owl:onDatatype xsd:integer ;
                                                                                            owl:withRestrictions ( [ xsd:minInclusive -9999
                                                                                                                   ]
                                                                                                                 )
                                                                                          ]
                                                                                          [ rdf:type rdfs:Datatype ;
                                                                                            owl:onDatatype xsd:integer ;
                                                                                            owl:withRestrictions ( [ xsd:maxInclusive -9999
                                                                                                                   ]
                                                                                                                 )
                                                                                          ]
                                                                                        )
                                                                   ]
                                                                   [ rdf:type rdfs:Datatype ;
                                                                     owl:intersectionOf ( [ rdf:type rdfs:Datatype ;
                                                                                            owl:onDatatype xsd:integer ;
                                                                                            owl:withRestrictions ( [ xsd:minInclusive 0
                                                                                                                   ]
                                                                                                                 )
                                                                                          ]
                                                                                          [ rdf:type rdfs:Datatype ;
                                                                                            owl:onDatatype xsd:integer ;
                                                                                            owl:withRestrictions ( [ xsd:maxInclusive 120
                                                                                                                   ]
                                                                                                                 )
                                                                                          ]
                                                                                        )
                                                                   ]
                                                                 )
                                                   ]
                                                   xsd:integer
                                                 )
                            ] ;
                 rdfs:label "Age" ;
                 skos:definition "The participant's age in years (0–120). The value -9999 is used for missing values." ;
                 skos:inScheme <https://w3id.org/OHD/DFA-study/superdataset> .


###  https://w3id.org/OHD/DFA-study/superdataset/Participant_id
superdataset:Participant_id rdf:type owl:DatatypeProperty ;
                            rdfs:range xsd:integer ;
                            rdfs:label "Participant_id" ;
                            skos:definition "The participant's study ID." ;
                            skos:inScheme <https://w3id.org/OHD/DFA-study/superdataset> .


###  https://w3id.org/OHD/DFA-study/superdataset/Participant_id_original
superdataset:Participant_id_original rdf:type owl:DatatypeProperty ;
                                     rdfs:range xsd:string ;
                                     rdfs:label "Participant_id_original" ;
                                     skos:definition "The participant's original study ID." ;
                                     skos:inScheme <https://w3id.org/OHD/DFA-study/superdataset> .


###  https://w3id.org/OHD/DFA-study/superdataset/Race
superdataset:Race rdf:type owl:DatatypeProperty ;
                  rdfs:range xsd:integer ;
                  rdfs:label "Race" ;
                  skos:definition "The participant's race. The value -9999 is used for missing values." ;
                  skos:inScheme <https://w3id.org/OHD/DFA-study/superdataset> .


###  https://w3id.org/OHD/DFA-study/superdataset/count_missing
superdataset:count_missing rdf:type owl:DatatypeProperty ;
                           rdfs:range xsd:integer ;
                           rdfs:label "count_missing" ;
                           skos:definition "The count of missing values in the record." ;
                           skos:inScheme <https://w3id.org/OHD/DFA-study/superdataset> .


###  https://w3id.org/OHD/DFA-study/superdataset/dfs_avoidance_fear
superdataset:dfs_avoidance_fear rdf:type owl:DatatypeProperty ;
                                rdfs:range xsd:integer ;
                                rdfs:label "dfs_avoidance_fear" ;
                                skos:definition "Sum dfs items 1, 2, 8, 9, 10, 11, 12, 13." ;
                                skos:inScheme <https://w3id.org/OHD/DFA-study/superdataset> .


###  https://w3id.org/OHD/DFA-study/superdataset/dfs_flag
superdataset:dfs_flag rdf:type owl:DatatypeProperty ;
                      rdfs:range xsd:integer ;
                      rdfs:label "dfs_flag" ;
                      skos:definition "The participant have dfs value or not." ;
                      skos:inScheme <https://w3id.org/OHD/DFA-study/superdataset> .


###  https://w3id.org/OHD/DFA-study/superdataset/dfs_physiological_arousal
superdataset:dfs_physiological_arousal rdf:type owl:DatatypeProperty ;
                                       rdfs:range xsd:integer ;
                                       rdfs:label "dfs_physiological_arousal" ;
                                       skos:definition "Sum dfs items 3, 4, 5, 6, 7." ;
                                       skos:inScheme <https://w3id.org/OHD/DFA-study/superdataset> .


###  https://w3id.org/OHD/DFA-study/superdataset/dfs_specific_stimuli_fear
superdataset:dfs_specific_stimuli_fear rdf:type owl:DatatypeProperty ;
                                       rdfs:range xsd:integer ;
                                       rdfs:label "dfs_specific_stimuli_fear" ;
                                       skos:definition "Sum dfs items 14, 15, 16, 17, 18, 19." ;
                                       skos:inScheme <https://w3id.org/OHD/DFA-study/superdataset> .


###  https://w3id.org/OHD/DFA-study/superdataset/dfs_total
superdataset:dfs_total rdf:type owl:DatatypeProperty ;
                       rdfs:range xsd:integer ;
                       rdfs:label "dfs_total" ;
                       skos:definition "Sum all 20 dfs items." ;
                       skos:inScheme <https://w3id.org/OHD/DFA-study/superdataset> .


###  https://w3id.org/OHD/DFA-study/superdataset/idaf_flag
superdataset:idaf_flag rdf:type owl:DatatypeProperty ;
                       rdfs:range xsd:integer ;
                       rdfs:label "idaf_flag" ;
                       skos:definition "The participant have idaf value or not." ;
                       skos:inScheme <https://w3id.org/OHD/DFA-study/superdataset> .


###  https://w3id.org/OHD/DFA-study/superdataset/mdas_flag
superdataset:mdas_flag rdf:type owl:DatatypeProperty ;
                       rdfs:range xsd:integer ;
                       rdfs:label "mdas_flag" ;
                       skos:definition "The participant have mdas value or not." ;
                       skos:inScheme <https://w3id.org/OHD/DFA-study/superdataset> .


