@prefix : <https://w3id.org/OHD/DFA-study/superdataset.owl.ttl#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix linkml: <https://w3id.org/linkml/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix superdataset: <https://w3id.org/OHD/DFA-study/superdataset/> .
@base <https://w3id.org/OHD/DFA-study/superdataset.owl.ttl> .

<https://w3id.org/OHD/DFA-study/superdataset.owl.ttl> rdf:type owl:Ontology ;
                                                       dcterms:license "https://mit-license.org/" ;
                                                       dcterms:title "DFA Superdataset Schema" ;
                                                       rdfs:label "superdataset" ;
                                                       skos:definition "LinkML schema for defining data elements used in the DFA Superdataset." .

#################################################################
#    Annotation properties
#################################################################

###  http://purl.org/dc/terms/license
dcterms:license rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/title
dcterms:title rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#definition
skos:definition rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#inScheme
skos:inScheme rdf:type owl:AnnotationProperty .


###  https://w3id.org/OHD/DFA-study/superdataset/pun_as
superdataset:pun_as rdf:type owl:AnnotationProperty .


###  https://w3id.org/linkml/permissible_values
linkml:permissible_values rdf:type owl:AnnotationProperty .


#################################################################
#    Object Properties
#################################################################

###  https://w3id.org/OHD/DFA-study/superdataset/records
superdataset:records rdf:type owl:ObjectProperty ;
                     rdfs:label "records" ;
                     skos:inScheme <https://w3id.org/OHD/DFA-study/superdataset> .


#################################################################
#    Data properties
#################################################################

###  https://w3id.org/OHD/DFA-study/superdataset/Age
superdataset:Age rdf:type owl:DatatypeProperty ;
                 rdfs:range [ rdf:type rdfs:Datatype ;
                              owl:intersectionOf ( [ rdf:type rdfs:Datatype ;
                                                     owl:unionOf ( [ rdf:type rdfs:Datatype ;
                                                                     owl:intersectionOf ( [ rdf:type rdfs:Datatype ;
                                                                                            owl:onDatatype xsd:integer ;
                                                                                            owl:withRestrictions ( [ xsd:minInclusive -9999
                                                                                                                   ]
                                                                                                                 )
                                                                                          ]
                                                                                          [ rdf:type rdfs:Datatype ;
                                                                                            owl:onDatatype xsd:integer ;
                                                                                            owl:withRestrictions ( [ xsd:maxInclusive -9999
                                                                                                                   ]
                                                                                                                 )
                                                                                          ]
                                                                                        )
                                                                   ]
                                                                   [ rdf:type rdfs:Datatype ;
                                                                     owl:intersectionOf ( [ rdf:type rdfs:Datatype ;
                                                                                            owl:onDatatype xsd:integer ;
                                                                                            owl:withRestrictions ( [ xsd:minInclusive 0
                                                                                                                   ]
                                                                                                                 )
                                                                                          ]
                                                                                          [ rdf:type rdfs:Datatype ;
                                                                                            owl:onDatatype xsd:integer ;
                                                                                            owl:withRestrictions ( [ xsd:maxInclusive 120
                                                                                                                   ]
                                                                                                                 )
                                                                                          ]
                                                                                        )
                                                                   ]
                                                                 )
                                                   ]
                                                   xsd:integer
                                                 )
                            ] ;
                 rdfs:label "Age" ;
                 skos:definition "The participant's age in years (0–120). The value -9999 is used for missing values." ;
                 skos:inScheme <https://w3id.org/OHD/DFA-study/superdataset> .


###  https://w3id.org/OHD/DFA-study/superdataset/Ethnicity
superdataset:Ethnicity rdf:type owl:DatatypeProperty ;
                       rdfs:range xsd:integer ;
                       rdfs:label "Ethnicity" ;
                       skos:definition "The participant's ethnicity is Hispanic." ;
                       skos:inScheme <https://w3id.org/OHD/DFA-study/superdataset> .


###  https://w3id.org/OHD/DFA-study/superdataset/Last_Dental_Visit
superdataset:Last_Dental_Visit rdf:type owl:DatatypeProperty ;
                               rdfs:range xsd:integer ;
                               rdfs:label "Last_Dental_Visit" ;
                               skos:definition "How long has it been since you last visited a dentist or dental clinic for any reason?" ;
                               skos:inScheme <https://w3id.org/OHD/DFA-study/superdataset> .


###  https://w3id.org/OHD/DFA-study/superdataset/Participant_id
superdataset:Participant_id rdf:type owl:DatatypeProperty ;
                            rdfs:range xsd:integer ;
                            rdfs:label "Participant_id" ;
                            skos:definition "The participant's study ID." ;
                            skos:inScheme <https://w3id.org/OHD/DFA-study/superdataset> .


###  https://w3id.org/OHD/DFA-study/superdataset/Participant_id_original
superdataset:Participant_id_original rdf:type owl:DatatypeProperty ;
                                     rdfs:range xsd:string ;
                                     rdfs:label "Participant_id_original" ;
                                     skos:definition "The participant's original study ID." ;
                                     skos:inScheme <https://w3id.org/OHD/DFA-study/superdataset> .


###  https://w3id.org/OHD/DFA-study/superdataset/Race
superdataset:Race rdf:type owl:DatatypeProperty ;
                  rdfs:range xsd:integer ;
                  rdfs:label "Race" ;
                  skos:definition "The participant's race. The value -9999 is used for missing values." ;
                  skos:inScheme <https://w3id.org/OHD/DFA-study/superdataset> .


###  https://w3id.org/OHD/DFA-study/superdataset/Sex
superdataset:Sex rdf:type owl:DatatypeProperty ;
                 rdfs:range xsd:integer ;
                 rdfs:label "Sex" ;
                 skos:definition "The participant's sex" ;
                 skos:inScheme <https://w3id.org/OHD/DFA-study/superdataset> .


###  https://w3id.org/OHD/DFA-study/superdataset/agegrp
superdataset:agegrp rdf:type owl:DatatypeProperty ;
                    rdfs:range xsd:integer ;
                    rdfs:label "agegrp" ;
                    skos:definition "The age group of the participant." ;
                    skos:inScheme <https://w3id.org/OHD/DFA-study/superdataset> .


###  https://w3id.org/OHD/DFA-study/superdataset/count_missing
superdataset:count_missing rdf:type owl:DatatypeProperty ;
                           rdfs:range xsd:integer ;
                           rdfs:label "count_missing" ;
                           skos:definition "The count of missing values in the record." ;
                           skos:inScheme <https://w3id.org/OHD/DFA-study/superdataset> .


