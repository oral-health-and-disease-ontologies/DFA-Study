    <!-- https://w3id.org/OHD/DFA-study/superdataset/AgeGroup -->

    <owl:Class rdf:about="https://w3id.org/OHD/DFA-study/superdataset/AgeGroup">
        <rdfs:label>AgeGroup</rdfs:label>
        <skos:definition>An enumeration for the age group of the participant.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/OHD/DFA-study/superdataset"/>
        <linkml:permissible_values>-9999</linkml:permissible_values>
        <linkml:permissible_values>1</linkml:permissible_values>
        <linkml:permissible_values>2</linkml:permissible_values>
        <linkml:permissible_values>3</linkml:permissible_values>
        <linkml:permissible_values>4</linkml:permissible_values>
        <linkml:permissible_values>5</linkml:permissible_values>
        <linkml:permissible_values>6</linkml:permissible_values>
    </owl:Class>
    


    <!-- https://w3id.org/OHD/DFA-study/superdataset/AnxietyMissing -->

    <owl:Class rdf:about="https://w3id.org/OHD/DFA-study/superdataset/AnxietyMissing">
        <rdfs:label>AnxietyMissing</rdfs:label>
        <skos:definition>Enumeration for answering whether an individual would feel anxious in some scenario.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/OHD/DFA-study/superdataset"/>
        <linkml:permissible_values>-9876</linkml:permissible_values>
        <linkml:permissible_values>-9999</linkml:permissible_values>
        <linkml:permissible_values>1</linkml:permissible_values>
        <linkml:permissible_values>2</linkml:permissible_values>
        <linkml:permissible_values>3</linkml:permissible_values>
        <linkml:permissible_values>4</linkml:permissible_values>
        <linkml:permissible_values>5</linkml:permissible_values>
    </owl:Class>
    


    <!-- https://w3id.org/OHD/DFA-study/superdataset/Dataset -->

    <owl:Class rdf:about="https://w3id.org/OHD/DFA-study/superdataset/Dataset">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/OHD/DFA-study/superdataset/records"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/OHD/DFA-study/superdataset/Record"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Dataset</rdfs:label>
        <skos:definition>The Superdataset dataset.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/OHD/DFA-study/superdataset"/>
    </owl:Class>
    


    <!-- https://w3id.org/OHD/DFA-study/superdataset/DegreeLikertMissing -->

    <owl:Class rdf:about="https://w3id.org/OHD/DFA-study/superdataset/DegreeLikertMissing">
        <rdfs:label>DegreeLikertMissing</rdfs:label>
        <skos:definition>A standard 5-point frequency Likert scale ranging from &quot;Not At All&quot; to &quot;Very Much&quot;, including an option for &apos;Missing&apos;.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/OHD/DFA-study/superdataset"/>
        <linkml:permissible_values>-9876</linkml:permissible_values>
        <linkml:permissible_values>-9999</linkml:permissible_values>
        <linkml:permissible_values>1</linkml:permissible_values>
        <linkml:permissible_values>2</linkml:permissible_values>
        <linkml:permissible_values>3</linkml:permissible_values>
        <linkml:permissible_values>4</linkml:permissible_values>
        <linkml:permissible_values>5</linkml:permissible_values>
    </owl:Class>
    


