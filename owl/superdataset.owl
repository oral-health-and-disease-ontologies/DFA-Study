<?xml version="1.0"?>
<rdf:RDF xmlns="https://w3id.org/OHD/DFA-study/superdataset.owl.ttl#"
     xml:base="https://w3id.org/OHD/DFA-study/superdataset.owl.ttl"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:linkml="https://w3id.org/linkml/"
     xmlns:dcterms="http://purl.org/dc/terms/"
     xmlns:superdataset="https://w3id.org/OHD/DFA-study/superdataset/">
    <owl:Ontology rdf:about="https://w3id.org/OHD/DFA-study/superdataset.owl.ttl">
        <dcterms:license>https://mit-license.org/</dcterms:license>
        <dcterms:title>DFA Superdataset Schema</dcterms:title>
        <rdfs:label>superdataset</rdfs:label>
        <skos:definition>LinkML schema for defining data elements used in the DFA Superdataset.</skos:definition>
    </owl:Ontology>
    


