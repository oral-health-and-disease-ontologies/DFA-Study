        <superdataset:pun_as>rdf:type owl:Class; rdfs:subClassOf OHD:0000439</superdataset:pun_as>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/OHD/DFA-study/superdataset/dfs19">
        <rdfs:label>dfs19</rdfs:label>
        <skos:definition>Please rate how much fear, anxiety, or unpleasantness each of these dental situations causes you: Having your teeth cleaned.</skos:definition>
