    <owl:Class rdf:about="https://w3id.org/OHD/DFA-study/superdataset/NoYes">
        <rdfs:label>NoYes</rdfs:label>
        <skos:definition>An enumeration for yes/no responses.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/OHD/DFA-study/superdataset"/>
        <linkml:permissible_values>0</linkml:permissible_values>
        <linkml:permissible_values>1</linkml:permissible_values>
    </owl:Class>
    


    <!-- https://w3id.org/OHD/DFA-study/superdataset/NoYesMissing -->

    <owl:Class rdf:about="https://w3id.org/OHD/DFA-study/superdataset/NoYesMissing">
        <rdfs:label>NoYesMissing</rdfs:label>
        <skos:definition>An enumeration for yes/no responses with a missing option.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/OHD/DFA-study/superdataset"/>
        <linkml:permissible_values>-9876</linkml:permissible_values>
        <linkml:permissible_values>-9999</linkml:permissible_values>
        <linkml:permissible_values>0</linkml:permissible_values>
        <linkml:permissible_values>1</linkml:permissible_values>
    </owl:Class>
    


    <!-- https://w3id.org/OHD/DFA-study/superdataset/Record -->

    <owl:Class rdf:about="https://w3id.org/OHD/DFA-study/superdataset/Record">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/OHD/DFA-study/superdataset/Age"/>
                <owl:allValuesFrom>
                    <rdfs:Datatype>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdfs:Datatype>
                                <owl:unionOf rdf:parseType="Collection">
                                    <rdfs:Datatype>
                                        <owl:intersectionOf rdf:parseType="Collection">
                                            <rdfs:Datatype>
                                                <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
                                                <owl:withRestrictions rdf:parseType="Collection">
                                                    <rdf:Description>
                                                        <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">-9999</xsd:minInclusive>
                                                    </rdf:Description>
                                                </owl:withRestrictions>
                                            </rdfs:Datatype>
                                            <rdfs:Datatype>
                                                <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
                                                <owl:withRestrictions rdf:parseType="Collection">
                                                    <rdf:Description>
                                                        <xsd:maxInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">-9999</xsd:maxInclusive>
                                                    </rdf:Description>
                                                </owl:withRestrictions>
                                            </rdfs:Datatype>
                                        </owl:intersectionOf>
                                    </rdfs:Datatype>
                                    <rdfs:Datatype>
                                        <owl:intersectionOf rdf:parseType="Collection">
                                            <rdfs:Datatype>
                                                <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
                                                <owl:withRestrictions rdf:parseType="Collection">
                                                    <rdf:Description>
                                                        <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</xsd:minInclusive>
                                                    </rdf:Description>
                                                </owl:withRestrictions>
                                            </rdfs:Datatype>
                                            <rdfs:Datatype>
                                                <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
                                                <owl:withRestrictions rdf:parseType="Collection">
                                                    <rdf:Description>
                                                        <xsd:maxInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">120</xsd:maxInclusive>
                                                    </rdf:Description>
                                                </owl:withRestrictions>
                                            </rdfs:Datatype>
                                        </owl:intersectionOf>
                                    </rdfs:Datatype>
