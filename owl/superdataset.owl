        <rdfs:label>FrequencyMissing</rdfs:label>
        <skos:definition>An enumeration for a Likert scale of frequency with a missing option.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/OHD/DFA-study/superdataset"/>
        <linkml:permissible_values>-9876</linkml:permissible_values>
        <linkml:permissible_values>-9999</linkml:permissible_values>
        <linkml:permissible_values>1</linkml:permissible_values>
        <linkml:permissible_values>2</linkml:permissible_values>
