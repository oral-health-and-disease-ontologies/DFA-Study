    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/OHD/DFA-study/superdataset/dfs2">
        <rdfs:label>dfs2</rdfs:label>
        <skos:definition>Has fear of dental work ever caused you to cancel or not appear for an appointment?</skos:definition>
