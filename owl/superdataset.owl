    <rdf:Description rdf:about="https://w3id.org/OHD/DFA-study/superdataset/dfs1">
        <rdfs:label>dfs1</rdfs:label>
        <skos:definition>Has fear of dental work ever caused you to put off making an appointment?</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/OHD/DFA-study/superdataset"/>
        <superdataset:pun_as>rdf:type owl:Class; rdfs:subClassOf OHD:0000421</superdataset:pun_as>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/OHD/DFA-study/superdataset/dfs10">
        <rdfs:label>dfs10</rdfs:label>
        <skos:definition>Please rate how much fear, anxiety, or unpleasantness each of these dental situations causes you: Sitting in the waiting room.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/OHD/DFA-study/superdataset"/>
        <superdataset:pun_as>rdf:type owl:Class; rdfs:subClassOf OHD:0000431</superdataset:pun_as>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/OHD/DFA-study/superdataset/dfs11">
        <rdfs:label>dfs11</rdfs:label>
        <skos:definition>Please rate how much fear, anxiety, or unpleasantness each of these dental situations causes you: Being seated in the dental chair.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/OHD/DFA-study/superdataset"/>
        <superdataset:pun_as>rdf:type owl:Class; rdfs:subClassOf OHD:0000432</superdataset:pun_as>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/OHD/DFA-study/superdataset/dfs12">
        <rdfs:label>dfs12</rdfs:label>
        <skos:definition>Please rate how much fear, anxiety, or unpleasantness each of these dental situations causes you: The smell of the dentist&apos;s office.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/OHD/DFA-study/superdataset"/>
        <superdataset:pun_as>rdf:type owl:Class; rdfs:subClassOf OHD:0000433</superdataset:pun_as>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/OHD/DFA-study/superdataset/dfs13">
        <rdfs:label>dfs13</rdfs:label>
        <skos:definition>Please rate how much fear, anxiety, or unpleasantness each of these dental situations causes you: Seeing the dentist walk in.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/OHD/DFA-study/superdataset"/>
        <superdataset:pun_as>rdf:type owl:Class; rdfs:subClassOf OHD:0000434</superdataset:pun_as>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/OHD/DFA-study/superdataset/dfs14">
        <rdfs:label>dfs14</rdfs:label>
        <skos:definition>Please rate how much fear, anxiety, or unpleasantness each of these dental situations causes you: Seeing the anesthetic needle.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/OHD/DFA-study/superdataset"/>
        <superdataset:pun_as>rdf:type owl:Class; rdfs:subClassOf OHD:0000435</superdataset:pun_as>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/OHD/DFA-study/superdataset/dfs15">
        <rdfs:label>dfs15</rdfs:label>
        <skos:definition>Please rate how much fear, anxiety, or unpleasantness each of these dental situations causes you: Feeling the needle injected.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/OHD/DFA-study/superdataset"/>
        <superdataset:pun_as>rdf:type owl:Class; rdfs:subClassOf OHD:0000436</superdataset:pun_as>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/OHD/DFA-study/superdataset/dfs16">
        <rdfs:label>dfs16</rdfs:label>
        <skos:definition>Please rate how much fear, anxiety, or unpleasantness each of these dental situations causes you: Seeing the drill.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/OHD/DFA-study/superdataset"/>
        <superdataset:pun_as>rdf:type owl:Class; rdfs:subClassOf OHD:0000437</superdataset:pun_as>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/OHD/DFA-study/superdataset/dfs17">
        <rdfs:label>dfs17</rdfs:label>
        <skos:definition>Please rate how much fear, anxiety, or unpleasantness each of these dental situations causes you: Hearing the drill.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/OHD/DFA-study/superdataset"/>
        <superdataset:pun_as>rdf:type owl:Class; rdfs:subClassOf OHD:0000438</superdataset:pun_as>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/OHD/DFA-study/superdataset/dfs18">
        <rdfs:label>dfs18</rdfs:label>
        <skos:definition>Please rate how much fear, anxiety, or unpleasantness each of these dental situations causes you: Feeling the vibrations of the drill.</skos:definition>
