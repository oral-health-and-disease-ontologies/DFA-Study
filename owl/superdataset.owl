    <!-- https://w3id.org/OHD/DFA-study/superdataset/records -->

    <owl:ObjectProperty rdf:about="https://w3id.org/OHD/DFA-study/superdataset/records">
        <rdfs:label>records</rdfs:label>
        <skos:inScheme rdf:resource="https://w3id.org/OHD/DFA-study/superdataset"/>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- https://w3id.org/OHD/DFA-study/superdataset/Age -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/OHD/DFA-study/superdataset/Age">
        <rdfs:range>
            <rdfs:Datatype>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdfs:Datatype>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdfs:Datatype>
                                <owl:intersectionOf rdf:parseType="Collection">
                                    <rdfs:Datatype>
                                        <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
                                        <owl:withRestrictions rdf:parseType="Collection">
                                            <rdf:Description>
                                                <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">-9999</xsd:minInclusive>
                                            </rdf:Description>
                                        </owl:withRestrictions>
                                    </rdfs:Datatype>
                                    <rdfs:Datatype>
                                        <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
                                        <owl:withRestrictions rdf:parseType="Collection">
                                            <rdf:Description>
                                                <xsd:maxInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">-9999</xsd:maxInclusive>
                                            </rdf:Description>
                                        </owl:withRestrictions>
                                    </rdfs:Datatype>
                                </owl:intersectionOf>
                            </rdfs:Datatype>
                            <rdfs:Datatype>
                                <owl:intersectionOf rdf:parseType="Collection">
                                    <rdfs:Datatype>
                                        <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
                                        <owl:withRestrictions rdf:parseType="Collection">
                                            <rdf:Description>
                                                <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</xsd:minInclusive>
                                            </rdf:Description>
                                        </owl:withRestrictions>
                                    </rdfs:Datatype>
                                    <rdfs:Datatype>
                                        <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
                                        <owl:withRestrictions rdf:parseType="Collection">
                                            <rdf:Description>
                                                <xsd:maxInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">120</xsd:maxInclusive>
                                            </rdf:Description>
                                        </owl:withRestrictions>
                                    </rdfs:Datatype>
                                </owl:intersectionOf>
                            </rdfs:Datatype>
                        </owl:unionOf>
                    </rdfs:Datatype>
                    <rdf:Description rdf:about="http://www.w3.org/2001/XMLSchema#integer"/>
                </owl:intersectionOf>
            </rdfs:Datatype>
        </rdfs:range>
        <rdfs:label>Age</rdfs:label>
        <skos:definition>The participant&apos;s age in years (0–120). The value -9999 is used for missing values.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/OHD/DFA-study/superdataset"/>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/OHD/DFA-study/superdataset/Ethnicity_new -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/OHD/DFA-study/superdataset/Ethnicity_new">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:label>Ethnicity_new</rdfs:label>
        <skos:definition>The participant&apos;s ethnicity is Hispanic.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/OHD/DFA-study/superdataset"/>
    </owl:DatatypeProperty>
    


